# Copy to .env and fill in. Never commit the real file.

# postgres://<user>:<password>@<host>:<port>/<database>
# Using a hosted Postgres (Supabase, Neon, RDS, etc)? Append ?sslmode=no-verify
# — most managed providers require an encrypted connection, but recent `pg`
# versions treat sslmode=require as full certificate-chain verification,
# which fails with SELF_SIGNED_CERT_IN_CHAIN against Supabase's pooler
# specifically. no-verify keeps the connection encrypted without validating
# the chain — fine for connecting to a provider you already trust by URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recur?schema=public"

NODE_ENV="development"
PORT=4000

# Comma-separated list of allowed browser origins, or "*" to allow any.
# Only matters for browser clients (a web dashboard, Flutter web) — native
# mobile apps don't send an Origin header, so this has no effect on them.
# Tighten this to your real domain(s) before launch.
CORS_ORIGIN="*"

# Long random string — used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# OTP config
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Email sending — swap for a real provider (Resend, SES, Postmark) before
# launch. Left blank in dev: OTPs are logged to the console instead.
EMAIL_PROVIDER="console"
EMAIL_FROM="Recur <noreply@recur.website>"
RESEND_API_KEY=""

# Mono open-banking (get these from app.mono.co/apps)
# - MONO_SECRET_KEY: server-side, authenticates every api.withmono.com call
# - MONO_WEBHOOK_SECRET: set when you add a webhook URL in the Mono dashboard;
#   point it at https://<your-domain>/webhooks/mono
# - MONO_REDIRECT_URL: where Mono sends the browser/webview after linking
#   finishes — doesn't need to be a real working page, the app just watches
#   for navigation to this URL to know linking is done.
MONO_SECRET_KEY=""
MONO_WEBHOOK_SECRET=""
MONO_REDIRECT_URL="https://recur.website/mono/callback"
