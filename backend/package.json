{
  "name": "recur-backend",
  "version": "0.1.0",
  "description": "Recur API — detects recurring charges from a linked Nigerian bank account, serves the Flutter app.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-transactions": "tsx src/db/seed-transactions.ts",
    "db:seed-demo": "tsx src/db/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/sensible": "^6.0.2",
    "argon2": "^0.41.1",
    "close-with-grace": "^2.1.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.0",
    "drizzle-orm": "^0.36.1",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "eslint": "^9.11.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
